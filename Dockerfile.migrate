# Imagen de un solo uso para ejecutar migraciones de Prisma.
# Compose la usa como servicio "migrate"; en Easypanel puede desplegarse
# como worker temporal con DATABASE_URL configurada.
FROM node:22-alpine AS migrate
RUN apk add --no-cache libc6-compat openssl
WORKDIR /app
COPY prisma ./prisma
RUN npm install --no-save --no-package-lock --no-audit --no-fund prisma@6.19.3
CMD ["npx", "prisma", "migrate", "deploy"]
